{% extends 'base.html.twig' %}

{% block title %}Categorias - MS Code{% endblock %}

{% block body %}
    {{ include('_navbar.html.twig') }}

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Categorias</h1>
            <a href="{{ path('app_categoria_categoria_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Nova Categoria
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nome</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for categorium in categorias %}
                        <tr>
                            <td class="ps-4">{{ categorium.id }}</td>
                            <td class="fw-medium">{{ categorium.nome }}</td>
                            <td class="text-end pe-4">
                                <a href="{{ path('app_categoria_categoria_edit', {'id': categorium.id}) }}" class="btn btn-sm btn-outline-secondary">
                                    Editar
                                </a>
                                <div class="d-inline-block ms-1">
                                    {{ include('categoria/categoria/_delete_form.html.twig') }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">Nenhuma categoria cadastrada ainda.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}