{% extends 'base.html.twig' %}

{% block title %}Editar Produto - MS Code{% endblock %}

{% block body %}
    {{ include('_navbar.html.twig') }}

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 mb-0">Editar Produto</h1>
                    <a href="{{ path('app_produto_produto_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Voltar para a lista
                    </a>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        {{ include('produto/produto/_form.html.twig', {'button_label': 'Atualizar'}) }}
                    </div>
                </div>

                <div class="mt-3 text-end">
                    {{ include('produto/produto/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}