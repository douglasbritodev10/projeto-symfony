{% extends 'base.html.twig' %}

{% block title %}Produtos - MS Code{% endblock %}

{% block body %}
    {{ include('_navbar.html.twig') }}

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-0">Produtos</h1>
                <p class="text-muted small mb-0">Gerencie os itens cadastrados no estoque</p>
            </div>
            <a href="{{ path('app_produto_produto_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Novo Produto
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Nome</th>
                                <th>Categoria</th>
                                <th>Descrição</th>
                                <th>Preço</th>
                                <th>Estoque</th>
                                <th class="text-end pe-4">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for produto in produtos %}
                            <tr>
                                <td class="ps-4 text-muted">#{{ produto.id }}</td>
                                <td class="fw-semibold">{{ produto.nome }}</td>
                                <td>
                                    {% if produto.categoria %}
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">
                                            #{{ produto.categoria.id }} - {{ produto.categoria.nome }}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-warning-subtle text-warning-emphasis">Sem categoria</span>
                                    {% endif %}
                                </td>
                                <td>{{ produto.descricao }}</td>
                                <td>R$ {{ produto.preco|number_format(2, ',', '.') }}</td>
                                <td>
                                    <span class="badge {{ produto.estoque > 0 ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }} fs-6">
                                        {{ produto.estoque }} un.
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="{{ path('app_produto_produto_show', {'id': produto.id}) }}" class="btn btn-sm btn-outline-info me-1" title="Visualizar">
                                        <i class="bi bi-eye"></i> Visualizar
                                    </a>
                                    <a href="{{ path('app_produto_produto_edit', {'id': produto.id}) }}" class="btn btn-sm btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                                    Nenhum produto encontrado.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}