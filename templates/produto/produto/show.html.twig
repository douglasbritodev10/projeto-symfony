{% extends 'base.html.twig' %}

{% block title %}Detalhes do Produto - MS Code{% endblock %}

{% block body %}
    {{ include('_navbar.html.twig') }}

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 mb-0">Detalhes do Produto</h1>
                    <a href="{{ path('app_produto_produto_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Voltar para a lista
                    </a>
                </div>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-0">
                        <table class="table table-striped mb-0">
                            <tbody>
                                <tr>
                                    <th class="ps-4 w-25">ID</th>
                                    <td>#{{ produto.id }}</td>
                                </tr>
                                <tr>
                                    <th class="ps-4">Nome</th>
                                    <td class="fw-semibold">{{ produto.nome }}</td>
                                </tr>
                                <tr>
                                    <th class="ps-4">Categoria</th>
                                    <td>
                                        {% if produto.categoria %}
                                            #{{ produto.categoria.id }} - {{ produto.categoria.nome }}
                                        {% else %}
                                            <span class="text-muted">Sem categoria</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th class="ps-4">Descrição</th>
                                    <td>{{ produto.descricao }}</td>
                                </tr>
                                <tr>
                                    <th class="ps-4">Preço</th>
                                    <td>R$ {{ produto.preco|number_format(2, ',', '.') }}</td>
                                </tr>
                                <tr>
                                    <th class="ps-4">Estoque</th>
                                    <td>{{ produto.estoque }} unidades</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a href="{{ path('app_produto_produto_edit', {'id': produto.id}) }}" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Editar Produto
                    </a>

                    {{ include('produto/produto/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}